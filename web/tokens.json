{
  "name": "Text-o-matic",
  "version": 2,
  "meta": {
    "source": "figma",
    "file": "https://www.figma.com/design/2qz7HUZpSowl87urNt5vYq/Type-Template-Maker",
    "synced": "2026-10-09",
    "note": "Raw copy of the Figma variables. Values starting with '@' alias another variable by its Figma name. Units are px unless stated."
  },
  "collections": {
    "Core": {
      "modes": ["Value"],
      "variables": {
        "color/color-black": "#132322",
        "color/color-near-black": "#474848",
        "color/color-grey": "#999999",
        "color/color-white": "#fbfef9",
        "color/color-mist": "#f0f3f4",
        "color/color-red": "#cb0106",
        "color/color-green": "#b7cdc0",
        "color/color-teal": "#035f55",
        "color/color-blue": "#75a7be",
        "color/color-blue-light": "#cee2e9",
        "font-size/n2": 8,
        "font-size/n1": 11,
        "font-size/1": 14,
        "font-size/2": 19,
        "font-size/3": 25,
        "font-size/4": 33,
        "font-size/5": 44,
        "font-size/6": 59,
        "font-size/7": 79,
        "font-size/8": 105,
        "spacing/1": 4,
        "spacing/2": 8,
        "spacing/3": 12,
        "spacing/4": 16,
        "spacing/5": 24,
        "spacing/6": 32,
        "spacing/7": 48,
        "spacing/8": 64,
        "spacing/9": 96,
        "spacing/10": 128,
        "radius/1": 4,
        "radius/2": 8,
        "radius/3": 16,
        "radius/4": 24,
        "border/base": 1,
        "border/thick": 2,
        "weight/display": "Regular",
        "weight/heading": "Regular",
        "weight/body": "Regular",
        "weight/ui": "Regular",
        "font-family/display": "Special Gothic Expanded One",
        "font-family/heading": "Special Gothic Expanded One",
        "font-family/body": "Special Gothic",
        "font-family/ui": "Special Gothic"
      }
    },
    "Color": {
      "modes": ["Default"],
      "variables": {
        "color/bg": "@color/color-mist",
        "color/bg-contrast": "@color/color-white",
        "color/text-ondark": "@color/color-white",
        "color/text-onlight": "@color/color-black",
        "color/text-disabled": { "alias": "@color/color-near-black", "opacity": 0.75 },
        "color/ui-accent": "@color/color-teal",
        "color/ui-contrast": "@color/color-red",
        "color/ui-disabled": { "alias": "@color/color-near-black", "opacity": 0.5 },
        "active": "@color/color-blue",
        "inactive": "@color/color-blue-light",
        "border": "@color/color-black"
      }
    },
    "Responsive": {
      "modes": ["Large", "Small"],
      "variables": {
        "type/display/1": ["@font-size/8", "@font-size/7"],
        "type/heading/h1": ["@font-size/6", "@font-size/5"],
        "type/heading/h2": ["@font-size/4", "@font-size/3"],
        "type/heading/h3": ["@font-size/1", "@font-size/n1"],
        "type/body/md": ["@font-size/1", "@font-size/1"],
        "type/body/sm": ["@font-size/n1", "@font-size/n1"],
        "type/ui/md": ["@font-size/1", "@font-size/1"],
        "type/ui/sm": ["@font-size/n1", "@font-size/n1"],
        "type/ui/xs": [10, 10],
        "spacers/padding-xs": ["@spacing/2", "@spacing/2"],
        "spacers/padding-sm": ["@spacing/4", "@spacing/3"],
        "spacers/padding-md": ["@spacing/5", "@spacing/4"],
        "spacers/padding-lg": ["@spacing/7", "@spacing/6"],
        "spacers/margin-xs": ["@spacing/2", "@spacing/2"],
        "spacers/margin-sm": ["@spacing/4", "@spacing/3"],
        "spacers/margin-md": ["@spacing/6", "@spacing/5"],
        "spacers/margin-lg": ["@spacing/8", "@spacing/7"],
        "spacers/btwn-module": ["@spacing/10", "@spacing/9"],
        "grid/columns": [12, 4],
        "grid/margin": ["@spacing/8", "@spacing/4"],
        "grid/gutter": ["@spacing/5", "@spacing/4"],
        "corner/sm": ["@radius/1", "@radius/1"],
        "corner/md": ["@radius/3", "@radius/2"],
        "corner/lg": ["@radius/4", "@radius/3"]
      }
    }
  },
  "textStyles": {
    "display/1": { "family": "font-family/display", "size": "type/display/1", "weight": "weight/display", "lineHeight": 1, "letterSpacing": 0 },
    "heading/h1": { "family": "font-family/heading", "size": "type/heading/h1", "weight": "weight/heading", "lineHeight": 1, "letterSpacing": 0 },
    "heading/h2": { "family": "font-family/heading", "size": "type/heading/h2", "weight": "weight/heading", "lineHeight": 1, "letterSpacing": 0 },
    "heading/h3": { "family": "font-family/heading", "size": "type/heading/h3", "weight": "weight/heading", "lineHeight": 1, "letterSpacing": 0 },
    "body/md": { "family": "font-family/body", "size": "type/body/md", "weight": "weight/body", "lineHeight": 1, "letterSpacing": 0 },
    "body/sm": { "family": "font-family/body", "size": "type/body/sm", "weight": "weight/body", "lineHeight": 1, "letterSpacing": 0 },
    "ui/md": { "family": "font-family/ui", "size": "type/ui/md", "weight": "weight/ui", "lineHeight": 1, "letterSpacing": 0, "textCase": "upper" },
    "ui/sm": { "family": "font-family/ui", "size": "type/ui/sm", "weight": "weight/ui", "lineHeight": 1, "letterSpacing": 0, "textCase": "upper" },
    "ui/xs": { "family": "font-family/ui", "size": "type/ui/xs", "weight": "weight/ui", "lineHeight": 1, "letterSpacing": 0, "textCase": "upper", "local": "Not yet in Figma: field error messages." }
  }
}
